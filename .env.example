# Copy to .env and fill in. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# Infrastructure (docker-compose overrides these three for the app container)
DATABASE_URL=postgresql+asyncpg://gcc:gcc@localhost:5432/gcc_agent
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# WhatsApp — Meta Cloud API (developers.facebook.com > your app > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=choose-any-random-string
WHATSAPP_API_VERSION=v23.0

# LLM — Google Gemini (https://aistudio.google.com/apikey)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Current ids as of Nov 2026 (check https://ai.google.dev/gemini-api/docs/models before changing)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# minimal | low | medium | high: minimal keeps replies well under the 3 s target
GEMINI_THINKING_LEVEL=minimal
EMBEDDING_DIM=768
LLM_TEMPERATURE=0.4
# Per LLM call; on timeout the agent falls back to rules + templates so the lead is still answered
LLM_TIMEOUT_SECONDS=4
LLM_HISTORY_MESSAGES=12
# Optional alternatives (pip install langchain-anthropic / langchain-openai):
# LLM_PROVIDER=anthropic  ANTHROPIC_API_KEY=  ANTHROPIC_MODEL=
# LLM_PROVIDER=openai     OPENAI_API_KEY=     OPENAI_MODEL=

# Persona (spec §3). Default true = never reveal being an AI/bot.
# Set false where disclosing automated chat is required; the agent then answers honestly if asked.
PERSONA_CONCEAL_AI=true
# Optional: a first name the consultant uses, and the agency name. Empty = never invented.
PERSONA_NAME=
COMPANY_NAME=
# "No walls of text": max characters per WhatsApp bubble and bubbles per reply
REPLY_MAX_CHARS=400
REPLY_MAX_MESSAGES=2

# Google Calendar OAuth client (Google Cloud Console > APIs & Services > Credentials, type "Web application")
# Authorised redirect URI: ${PUBLIC_BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it stable: changing it makes the stored refresh token unreadable (re-connect the calendar).
TOKEN_ENCRYPTION_KEY=
# Required to open /auth/google/start?token=... (connecting the owner's calendar). Empty = disabled.
ADMIN_TOKEN=
# JSON list. calendar.events = create the meeting + invite the lead; calendar.freebusy = busy times only.
GOOGLE_OAUTH_SCOPES=["https://www.googleapis.com/auth/calendar.events","https://www.googleapis.com/auth/calendar.freebusy"]
GOOGLE_API_TIMEOUT_SECONDS=10

# Knowledge base (Qdrant RAG). Needs GEMINI_API_KEY + GEMINI_EMBEDDING_MODEL above; without an
# embedding model the knowledge base is off and every legal/tax question is deferred to the call.
# Load the facts with: python scripts/ingest_kb.py ingest
RAG_COLLECTION=gcc_knowledge
PROPERTIES_COLLECTION=properties
KNOWLEDGE_DIR=knowledge_base/facts
RAG_TOP_K=3
# Minimum similarity for a passage to count as an answer. 0.6 is untested with real embeddings:
# calibrate with `python scripts/ingest_kb.py search "..." --all-scores` after the first ingest.
RAG_SCORE_THRESHOLD=0.6
# Embed the question + search; on timeout the agent defers to the call
RAG_TIMEOUT_SECONDS=2.5
# validate/ingest warn about facts not re-checked on their official sources for this many days
RAG_FACT_MAX_AGE_DAYS=180
# true for gemini-embedding-2 (task given as a text prefix); false for gemini-embedding-001 (task_type)
GEMINI_EMBEDDING_TASK_PREFIXES=true
EMBEDDING_TIMEOUT_SECONDS=30
QDRANT_TIMEOUT_SECONDS=5

# Owner / scheduling
# Leads see times in their own timezone from the phone country code: +971 GST, +966/+974/+965 AST.
# Any other country code falls back to OWNER_TIMEZONE.
DEFAULT_OWNER_ID=default
OWNER_NAME=Property Consultant
OWNER_EMAIL=
OWNER_CALENDAR_ID=primary
OWNER_TIMEZONE=Asia/Dubai
# Mon=0 ... Sun=6 (JSON list)
WORKING_DAYS=[0,1,2,3,4]
WORK_START=09:00
WORK_END=18:00
SLOT_DURATION_MINUTES=30
SLOT_COUNT=3
SLOTS_PER_DAY=1
MIN_NOTICE_MINUTES=120
SLOT_SEARCH_DAYS=14

# Budget normalisation: local currency per 1 USD
RATE_AED=3.6725
RATE_SAR=3.75
RATE_QAR=3.64
RATE_KWD=0.307
